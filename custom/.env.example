# =============================================================================
# Grafana Environment Variables - Example
# =============================================================================
# Copy this file to .env and fill in your actual values
# Then run: docker compose -f custom/docker-compose.yaml --env-file custom/.env up -d
# =============================================================================

# Database Configuration
GF_DATABASE_TYPE=mysql
GF_DATABASE_HOST=your-database-host:3306
GF_DATABASE_NAME=your-database-name
GF_DATABASE_USER=your-database-user
GF_DATABASE_PASSWORD=your-database-password

# Optional: Additional Grafana settings
# GF_SERVER_DOMAIN=your-domain.com
# GF_SERVER_ROOT_URL=https://your-domain.com