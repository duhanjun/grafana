# Grafana 环境变量配置
# 在 Portainer 的 Stack 环境变量配置中设置这些变量

# ========== 容器配置 ==========
GRAFANA_VERSION=latest
CONTAINER_NAME=Grafana
GRAFANA_PORT=3000
GRAFANA_INTERNAL_PORT=3000

# ========== 数据库配置 ==========
GF_DATABASE_TYPE=mysql
GF_DATABASE_HOST=
GF_DATABASE_NAME=grafana
GF_DATABASE_USER=
GF_DATABASE_PASSWORD=
