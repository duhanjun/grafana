# Grafana 环境变量配置
# 在 Portainer 的 Stack 配置中设置这些环境变量

# Grafana 版本（可选，默认 10.0.0）
GRAFANA_VERSION=10.0.0

# 容器名称（可选）
CONTAINER_NAME=Grafana

# Grafana 端口（可选）
GRAFANA_PORT=3000

# ========== 数据库配置（必填）==========
# MySQL 数据库主机地址
GF_DATABASE_HOST=your-mysql-host.example.com:3306

# 数据库名称
GF_DATABASE_NAME=grafana

# 数据库用户名
GF_DATABASE_USER=grafana_db

# 数据库密码
GF_DATABASE_PASSWORD=your-database-password

# ========== Grafana 管理员账号（必填）==========
# 管理员用户名
GF_SECURITY_ADMIN_USER=admin

# 管理员密码（建议设置强密码）
GF_SECURITY_ADMIN_PASSWORD=your-admin-password

# ========== 服务器配置（可选）==========
# Grafana 服务器域名（用于生成正确的 URL）
GF_SERVER_DOMAIN=grafana.example.com

# 服务器根 URL
GF_SERVER_ROOT_URL=https://%(domain)s/
