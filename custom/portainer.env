# Grafana 环境变量配置
# 在 Portainer 的 Stack 环境变量配置中设置这些变量

# ========== 容器配置（必填）==========
# Grafana 镜像版本（可用 latest 或具体版本号如 13.0.1）
GRAFANA_VERSION=latest

# 容器名称
CONTAINER_NAME=Grafana

# 宿主机端口（必填）
GRAFANA_PORT=

# 容器内部端口（必填）
GRAFANA_INTERNAL_PORT=

# ========== 数据库配置（必填）==========
# 数据库类型（支持：mysql, postgres, sqlite3）
GF_DATABASE_TYPE=mysql

# 数据库主机地址
GF_DATABASE_HOST=your-mysql-host.example.com:3306

# 数据库名称
GF_DATABASE_NAME=grafana

# 数据库用户名
GF_DATABASE_USER=grafana_db

# 数据库密码
GF_DATABASE_PASSWORD=your-database-password
